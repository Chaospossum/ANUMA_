PDS_VERSION_ID            = "PDS3"

/*** This label describes a compressed image file, its corresponding XML    */
/*** file, and map projection information.                                  */
/*** The files described have the same name as this label but different     */
/*** extensions. They are:                                                  */
/***    .JP2 - A compressed image file corresponding to the uncompressed IMG*/
/***           file, stored with JPEG2000 compression                       */
/***    .XML - An auxiliary text file in XML, provided to aid display of    */
/***           the JPEG2000 image with certain image processing software    */
/*** The map projection information includes parameters that are specific   */
/*** to this image. They are intended to be used with the general map       */
/*** projection descriptions in the file indicated by the keyword           */
/*** ^DATA_SET_MAP_PROJECTION. That file is found in the CATALOG directory  */
/*** of this archive.                                                       */

/*** GENERAL DATA DESCRIPTION PARAMETERS ***/

PRODUCT_VERSION_ID        = "V1.05"
DATA_SET_ID               = "LRO-L-LOLA-4-GDR-V1.0"
PRODUCT_ID                = "AVGVISIB_65S_240M_201608"
INSTRUMENT_HOST_NAME      = "LUNAR RECONNAISSANCE ORBITER"
INSTRUMENT_NAME           = "LUNAR ORBITER LASER ALTIMETER"
INSTRUMENT_ID             = "LOLA"
MISSION_PHASE_NAME        = {"COMMISSIONING","NOMINAL MISSION","SCIENCE
                              MISSION","EXTENDED SCIENCE MISSION"}
TARGET_NAME               = MOON
START_TIME                = 2009-07-13T17:33:17.246
STOP_TIME                 = 2013-07-18T14:12:13
PRODUCT_CREATION_TIME     = 2016-09-15T00:00:00
PRODUCER_ID               = LRO_LOLA_TEAM
PRODUCER_FULL_NAME        = "DAVID E. SMITH"
PRODUCER_INSTITUTION_NAME = "GODDARD SPACE FLIGHT CENTER"
DESCRIPTION               = "This data product is a map of the average
   illumination by the solar disc of the Lunar South Pole at a resolution of 
   240m/pix by 240m/pix, true at the pole in polar stereographic 
   (spherical) projection.  The calculations are based on the LOLA elevation
   map LDEM_65S_240M and are described in [MAZARICOETAL2011]. The values are
   continuous between 0 (permanent shadow) and 1, and indicate the percentage
   of timesteps where each pixel was sunlit (by any fraction of the solar 
   disc). Note a scaling was applied to fit the data in the INT16 value range.
   It also makes it visible when opening this file in regular image viewer 
   software (e.g., Preview).

   This label describes two objects.  The first is a JP2 file of
   the corresponding uncompressed .IMG file.  A jpeg 2000 compression
   is used to render the image.  The second is an auxiliary xml file
   that contains extensible markup language that is interpreted by
   GDAL readers (www.gdal.org).

"

OBJECT                    = COMPRESSED_FILE
FILE_NAME                 = "AVGVISIB_65S_240M_201608.JP2"
RECORD_TYPE               = UNDEFINED
FILE_RECORDS              = UNK
ENCODING_TYPE             = "JP2"
  INTERCHANGE_FORMAT      = BINARY
  UNIT                    = NONE
  SCALING_FACTOR          = 0.00004
  OFFSET                  = 0.0
  UNCOMPRESSED_FILE_NAME  = "AVGVISIB_65S_240M_201608.IMG"
  REQUIRED_STORAGE_BYTES  = "48625783"
  ^DESCRIPTION            = "JP2INFO.TXT"
END_OBJECT                = COMPRESSED_FILE

OBJECT                    = UNCOMPRESSED_FILE
FILE_NAME                 = "AVGVISIB_65S_240M_201608.IMG"
RECORD_TYPE               = FIXED_LENGTH
FILE_RECORDS              = 6420
RECORD_BYTES              = 12840
^IMAGE                    = "AVGVISIB_65S_240M_201608.IMG"

  OBJECT                  = IMAGE
    NAME                  = AVERAGE_VISIBILITY
    DESCRIPTION           = "Each sample is a binary value that indicates 
      whether that location is in permanent shadow (DN=0, scaling to 0)
      or its average solar disc visibility (DN up to 25000, scaling to 1)."
    LINES                 = 6420
    LINE_SAMPLES          = 6420
    DERIVED_MINIMUM       = 0
    DERIVED_MAXIMUM       = 23369
    SAMPLE_TYPE           = LSB_INTEGER
    SAMPLE_BITS           = 16
    UNIT                  = NONE
    SCALING_FACTOR        = 0.00004
    OFFSET                = 0.0

/* NOTE:                                                                   */
/* The conversion from Digital Number to the AVERAGE_VISIBILITY flag is:   */
/* AVERAGE_VISIBILITY = (DN * SCALING_FACTOR) + OFFSET                     */

  END_OBJECT              = IMAGE
END_OBJECT                = UNCOMPRESSED_FILE

OBJECT                    = AUX_FILE
  FILE_NAME               = "AVGVISIB_65S_240M_201608_AUX.XML"
  RECORD_TYPE             = STREAM
  FILE_RECORDS            = UNK
  DESCRIPTION             = "This is an auxiliary file accompanying
     the JPEG2000 file. It contains metadata in XML format that
     is useful for displaying the image using a GDAL supported tool."
END_OBJECT                = AUX_FILE

OBJECT                    = IMAGE_MAP_PROJECTION
 ^DATA_SET_MAP_PROJECTION     = "DSMAP_POLAR.CAT"
 MAP_PROJECTION_TYPE          = "POLAR STEREOGRAPHIC"
 KEYWORD_LATITUDE_TYPE        = "PLANETOCENTRIC"
 MAP_RESOLUTION               = 126.347 <pix/deg>
 A_AXIS_RADIUS                = 1737.4 <km>
 B_AXIS_RADIUS                = 1737.4 <km>
 C_AXIS_RADIUS                = 1737.4 <km>
 FIRST_STANDARD_PARALLEL      = 'N/A'
 SECOND_STANDARD_PARALLEL     = 'N/A'
 POSITIVE_LONGITUDE_DIRECTION = "EAST"
 CENTER_LATITUDE              = -90 <deg>
 CENTER_LONGITUDE             = 180 <deg>
 REFERENCE_LATITUDE           = 'N/A'
 REFERENCE_LONGITUDE          = 'N/A'
 LINE_FIRST_PIXEL             = 1
 LINE_LAST_PIXEL              = 6420
 SAMPLE_FIRST_PIXEL           = 1
 SAMPLE_LAST_PIXEL            = 6420
 MAP_PROJECTION_ROTATION      = 0.0
 MAP_SCALE                    = 240 <m/pix>
 MAXIMUM_LATITUDE             = -55.2 <deg>
 MINIMUM_LATITUDE             = -90 <deg>
 WESTERNMOST_LONGITUDE        = 'N/A'
 EASTERNMOST_LONGITUDE        = 'N/A'
 LINE_PROJECTION_OFFSET       = 3209.5 <pix>
 SAMPLE_PROJECTION_OFFSET     = 3209.5 <pix>
 COORDINATE_SYSTEM_TYPE       = "BODY-FIXED ROTATING"
 COORDINATE_SYSTEM_NAME       = "MEAN EARTH/POLAR AXIS OF DE421"
END_OBJECT                    = IMAGE_MAP_PROJECTION

END
